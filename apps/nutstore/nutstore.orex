#!/usr/bin/orex

@manifest
id:      nutstore
name:    NutStore
icon:    🥜
version: 1.0.3
type:    gui
size:    720x520
single:  true
desc:    Магазин приложений OrexOS. Устанавливай, обновляй и удаляй приложения из репозитория.
author:  Orexia Systems
@end

@style
:root {
  display: flex;
  flex-direction: column;
  height: 100%;
  font-family: "MS Sans Serif", Arial, sans-serif;
  font-size: 12px;
  background: #c0c0c0;
  overflow: hidden;
}

.ns-toolbar {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 6px;
  background: #c0c0c0;
  border-bottom: 1px solid #808080;
  flex-shrink: 0;
}
.ns-toolbar button {
  font-size: 11px;
  padding: 2px 8px;
  cursor: pointer;
}
.ns-toolbar .ns-search {
  flex: 1;
  margin-left: 8px;
  padding: 2px 4px;
  font-size: 12px;
  border: 2px inset #fff;
}
.ns-toolbar .ns-status-text {
  font-size: 11px;
  color: #444;
  margin-left: 8px;
  white-space: nowrap;
}

.ns-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

.ns-sidebar {
  width: 150px;
  background: #fff;
  border-right: 2px groove #c0c0c0;
  overflow-y: auto;
  flex-shrink: 0;
}
.ns-cat-item {
  padding: 5px 10px;
  cursor: pointer;
  font-size: 12px;
  border-bottom: 1px solid #e0e0e0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ns-cat-item:hover { background: #e8e8e8; }
.ns-cat-item.active {
  background: #000080;
  color: #fff;
}

.ns-content {
  flex: 1;
  overflow-y: auto;
  background: #fff;
  min-width: 0;
}

.ns-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 8px;
  padding: 8px;
}

.ns-card {
  border: 2px outset #c0c0c0;
  background: #f0f0f0;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  cursor: default;
  min-height: 120px;
}
.ns-card:hover { background: #e8e8ff; }

.ns-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
}
.ns-card-icon { font-size: 28px; line-height: 1; }
.ns-card-title {
  font-weight: bold;
  font-size: 12px;
  word-break: break-word;
}
.ns-card-ver {
  font-size: 10px;
  color: #666;
}
.ns-card-desc {
  font-size: 11px;
  color: #333;
  flex: 1;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.ns-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
}
.ns-card-cats {
  font-size: 9px;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.ns-card-footer button {
  font-size: 11px;
  padding: 2px 10px;
  cursor: pointer;
  white-space: nowrap;
}
.ns-btn-install { background: #4a4; color: #fff; border: 2px outset #6c6; }
.ns-btn-install:hover { background: #393; }
.ns-btn-install:active { border-style: inset; }
.ns-btn-update { background: #48c; color: #fff; border: 2px outset #6ae; }
.ns-btn-update:hover { background: #37b; }
.ns-btn-remove { background: #c44; color: #fff; border: 2px outset #e66; }
.ns-btn-remove:hover { background: #b33; }
.ns-btn-launch { background: #888; color: #fff; border: 2px outset #aaa; }
.ns-btn-launch:hover { background: #777; }
.ns-btn-disabled { opacity: 0.5; pointer-events: none; }

.ns-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: 16px;
  color: #666;
}

.ns-empty {
  padding: 40px;
  text-align: center;
  color: #888;
  font-size: 13px;
}

.ns-detail-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.ns-detail-panel {
  background: #c0c0c0;
  border: 2px outset #ddd;
  width: 420px;
  max-height: 80%;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ns-detail-panel h2 {
  margin: 0;
  font-size: 16px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.ns-detail-panel .ns-detail-meta {
  font-size: 11px;
  color: #444;
  line-height: 1.6;
}
.ns-detail-panel .ns-detail-desc {
  font-size: 12px;
  color: #222;
  border: 2px inset #fff;
  background: #fff;
  padding: 8px;
}
.ns-detail-btns {
  display: flex;
  gap: 6px;
  justify-content: flex-end;
}
.ns-detail-btns button {
  padding: 3px 16px;
  font-size: 12px;
  cursor: pointer;
}

.ns-statusbar {
  padding: 3px 8px;
  background: #c0c0c0;
  border-top: 2px groove #fff;
  font-size: 11px;
  color: #333;
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
}
@end

@template
<div class="ns-toolbar">
  <button id="ns-btn-refresh" title="Обновить каталог">🔄 Обновить</button>
  <button id="ns-btn-selfupdate" title="Обновить NutStore">🥜 Обновить себя</button>
  <input class="ns-search" id="ns-search" type="text" placeholder="🔍 Поиск приложений..." />
  <span class="ns-status-text" id="ns-status-text"></span>
</div>
<div class="ns-body">
  <div class="ns-sidebar" id="ns-sidebar"></div>
  <div class="ns-content" id="ns-content">
    <div class="ns-loading">🥜 Загрузка каталога...</div>
  </div>
</div>
<div class="ns-statusbar">
  <span id="ns-statusbar-left">Готов</span>
  <span id="ns-statusbar-right"></span>
</div>
@end

@script
function init($el, kernel, pid, args) {

  /* ─── Константы ─── */
  const REPO_BASE = 'https://raw.githubusercontent.com/Vasysik/orexos-nutrepo/main/';
  const INDEX_URL = REPO_BASE + 'index.json';

  /* ─── DOM ─── */
  const sidebar     = $el.querySelector('#ns-sidebar');
  const content     = $el.querySelector('#ns-content');
  const searchInput = $el.querySelector('#ns-search');
  const btnRefresh  = $el.querySelector('#ns-btn-refresh');
  const btnSelf     = $el.querySelector('#ns-btn-selfupdate');
  const statusLeft  = $el.querySelector('#ns-statusbar-left');
  const statusRight = $el.querySelector('#ns-statusbar-right');
  const statusText  = $el.querySelector('#ns-status-text');

  /* ─── Состояние ─── */
  let catalog      = null;
  let installedMap = {};       // Данные генерируются на лету из файловой системы!
  let activeCategory = null;
  let searchQuery  = '';
  let busy         = false;

  /* ─── Имена категорий (UI) ─── */
  const CAT_LABELS = {
    system:      '⚙️ Система',
    games:       '🎮 Игры',
    utilities:   '🔧 Утилиты',
    monitoring:  '📊 Мониторинг',
    multimedia:  '🎵 Мультимедиа',
    development: '💻 Разработка',
    network:     '🌐 Сеть',
    education:   '📚 Образование',
    fun:         '🎉 Развлечения',
    nuts:        '🌰 Орехи',
    productivity:'📋 Продуктивность',
    cli:         '🖥️ CLI',
    library:     '📦 Библиотека',
  };
  function catLabel(id) {
    return CAT_LABELS[id] || ('📁 ' + id.charAt(0).toUpperCase() + id.slice(1));
  }

  /* ─── ЧТЕНИЕ РЕАЛЬНОЙ ФАЙЛОВОЙ СИСТЕМЫ ─── */
  // Эта функция читает файлы с диска и парсит их версии. 
  // Никаких сохранений в localStorage (kernel.state).
  function syncWithFS() {
    installedMap = {};
    if (!catalog) return;

    for (const app of catalog.apps) {
      const ext = (app.file || 'orex').split('.').pop();
      const filePath = `/apps/${app.id}.${ext}`;

      try {
        let content = kernel.fs.read(filePath);
        // Защита: разные версии ядра могут возвращать строку или объект {ok: true, data: ...}
        let text = typeof content === 'string' ? content : (content && content.data ? content.data : null);

        if (text) {
          // Файл физически существует. Вытаскиваем версию регуляркой прямо из кода.
          const vMatch = text.match(/version:\s*([^\r\n]+)/);
          installedMap[app.id] = {
            version: vMatch ? vMatch[1].trim() : '?',
            path: filePath
          };
        }
      } catch (e) {
        // Файл не найден — значит не установлено
      }
    }
  }

  function getInstalledInfo(appId) {
    return installedMap[appId] || null;
  }

  function isNewer(remoteVer, localVer) {
    if (!localVer || localVer === '?') return true;
    const r = remoteVer.split('.').map(Number);
    const l = localVer.split('.').map(Number);
    for (let i = 0; i < Math.max(r.length, l.length); i++) {
      const rv = r[i] || 0, lv = l[i] || 0;
      if (rv > lv) return true;
      if (rv < lv) return false;
    }
    return false;
  }

  function getFilteredApps() {
    if (!catalog || !catalog.apps) return [];
    let apps = catalog.apps;
    if (activeCategory) {
      apps = apps.filter(a => (a.categories || []).includes(activeCategory));
    }
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      apps = apps.filter(a =>
        a.name.toLowerCase().includes(q) ||
        a.description.toLowerCase().includes(q) ||
        a.id.toLowerCase().includes(q) ||
        (a.author || '').toLowerCase().includes(q)
      );
    }
    return apps;
  }

  function renderSidebar() {
    if (!catalog) { sidebar.innerHTML = ''; return; }
    const cats = catalog.categories || [];
    let html = '';
    html += `<div class="ns-cat-item${activeCategory === null ? ' active' : ''}" data-cat="__all__">📋 Все (${catalog.apps.length})</div>`;
    for (const c of cats) {
      const count = catalog.apps.filter(a => (a.categories || []).includes(c)).length;
      const active = activeCategory === c ? ' active' : '';
      html += `<div class="ns-cat-item${active}" data-cat="${c}">${catLabel(c)} (${count})</div>`;
    }
    sidebar.innerHTML = html;
    sidebar.querySelectorAll('.ns-cat-item').forEach(el => {
      el.addEventListener('click', () => {
        activeCategory = el.dataset.cat === '__all__' ? null : el.dataset.cat;
        renderSidebar();
        renderGrid();
      });
    });
  }

  function renderGrid() {
    const apps = getFilteredApps();
    if (apps.length === 0) {
      content.innerHTML = '<div class="ns-empty">🥜 Ничего не найдено</div>';
      statusLeft.textContent = 'Приложений: 0';
      return;
    }

    let html = '<div class="ns-grid">';
    for (const app of apps) {
      const inst = getInstalledInfo(app.id);
      const hasUpdate = inst && isNewer(app.version, inst.version);
      const isSelf = app.id === 'nutstore';

      let btnHtml = '';
      if (inst && hasUpdate && !isSelf) {
        btnHtml = `<button class="ns-btn-update" data-action="install" data-id="${app.id}">⬆️ Обновить</button>`;
      } else if (inst && !hasUpdate) {
        btnHtml = `<button class="ns-btn-launch" data-action="launch" data-id="${app.id}">▶️ Запустить</button>`;
        if (!isSelf) {
          btnHtml += ` <button class="ns-btn-remove" data-action="remove" data-id="${app.id}">✕</button>`;
        }
      } else {
        btnHtml = `<button class="ns-btn-install" data-action="install" data-id="${app.id}">📥 Установить</button>`;
      }

      html += `
        <div class="ns-card" data-id="${app.id}">
          <div class="ns-card-header">
            <span class="ns-card-icon">${app.icon || '📦'}</span>
            <div>
              <div class="ns-card-title">${esc(app.name)}</div>
              <div class="ns-card-ver">v${esc(app.version)}${app.author ? ' • ' + esc(app.author) : ''}</div>
            </div>
          </div>
          <div class="ns-card-desc">${esc(app.description || '')}</div>
          <div class="ns-card-footer">
            <span class="ns-card-cats">${(app.categories || []).map(c => catLabel(c)).join(', ')}</span>
            ${btnHtml}
          </div>
        </div>`;
    }
    html += '</div>';
    content.innerHTML = html;
    statusLeft.textContent = `Приложений: ${apps.length}`;

    content.querySelectorAll('button[data-action]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        const action = btn.dataset.action;
        const id = btn.dataset.id;
        if (action === 'install') installApp(id);
        else if (action === 'remove') removeApp(id);
        else if (action === 'launch') launchApp(id);
      });
    });
    content.querySelectorAll('.ns-card').forEach(card => {
      card.addEventListener('dblclick', () => showDetail(card.dataset.id));
    });
  }

  function showDetail(appId) {
    const app = catalog.apps.find(a => a.id === appId);
    if (!app) return;
    const inst = getInstalledInfo(appId);
    const hasUpdate = inst && isNewer(app.version, inst.version);
    const isSelf = app.id === 'nutstore';

    let btnsHtml = '';
    if (!inst) {
      btnsHtml += `<button class="ns-btn-install" data-action="install">📥 Установить</button>`;
    } else if (hasUpdate && !isSelf) {
      btnsHtml += `<button class="ns-btn-update" data-action="install">⬆️ Обновить до v${esc(app.version)}</button>`;
    }
    if (inst && !isSelf) {
      btnsHtml += `<button class="ns-btn-remove" data-action="remove">🗑 Удалить</button>`;
    }
    if (inst) {
      btnsHtml += `<button class="ns-btn-launch" data-action="launch">▶️ Запустить</button>`;
    }
    btnsHtml += `<button data-action="close">Закрыть</button>`;

    const overlay = document.createElement('div');
    overlay.className = 'ns-detail-overlay';
    overlay.innerHTML = `
      <div class="ns-detail-panel">
        <h2><span style="font-size:32px">${app.icon || '📦'}</span> ${esc(app.name)}</h2>
        <div class="ns-detail-meta">
          <b>ID:</b> ${esc(app.id)}<br>
          <b>Версия:</b> ${esc(app.version)}${inst ? ' (установлена: ' + esc(inst.version) + ')' : ''}<br>
          <b>Автор:</b> ${esc(app.author || '—')}<br>
          <b>Категории:</b> ${(app.categories || []).map(c => catLabel(c)).join(', ') || '—'}<br>
          <b>Зависимости:</b> ${(app.deps || []).length > 0 ? app.deps.map(d => esc(d)).join(', ') : 'нет'}<br>
          <b>Размер:</b> ${app.size ? formatSize(app.size) : '?'}<br>
          <b>Файл:</b> ${esc(app.file || '?')}
        </div>
        <div class="ns-detail-desc">${esc(app.description || 'Без описания')}</div>
        <div class="ns-detail-btns">${btnsHtml}</div>
      </div>`;

    overlay.addEventListener('click', e => {
      if (e.target === overlay) overlay.remove();
    });
    overlay.querySelectorAll('button[data-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const action = btn.dataset.action;
        if (action === 'close') { overlay.remove(); return; }
        overlay.remove();
        if (action === 'install') await installApp(appId);
        else if (action === 'remove') await removeApp(appId);
        else if (action === 'launch') launchApp(appId);
      });
    });

    $el.style.position = 'relative';
    $el.appendChild(overlay);
  }

  async function installApp(appId, _depChain = new Set()) {
    if (busy) return;
    if (_depChain.has(appId)) return;
    _depChain.add(appId);

    const app = catalog.apps.find(a => a.id === appId);
    if (!app) return;

    busy = true;
    setStatus(`Установка ${app.name}...`);

    try {
      if (app.deps && app.deps.length > 0) {
        for (const depId of app.deps) {
          const depInstalled = getInstalledInfo(depId);
          const depInCatalog = catalog.apps.find(a => a.id === depId);
          if (!depInstalled || (depInCatalog && isNewer(depInCatalog.version, depInstalled.version))) {
            setStatus(`Зависимость: ${depId}...`);
            busy = false; 
            await installApp(depId, _depChain);
            busy = true;
          }
        }
      }

      setStatus(`Скачивание ${app.name}...`);
      const url = REPO_BASE + app.downloadUrl;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const code = await res.text();

      const ext = (app.file || 'orex').split('.').pop();
      const filePath = `/apps/${app.id}.${ext}`;

      setStatus(`Сохранение ${app.name}...`);
      const wr = kernel.fs.write(filePath, code);
      if (wr && typeof wr === 'object' && !wr.ok) throw new Error('Ошибка записи: ' + (wr.error || '?'));

      setStatus(`Регистрация ${app.name}...`);
      await kernel.launchOrex(filePath, { _registerOnly: true });

      // Обновляем список из ФАЙЛОВОЙ СИСТЕМЫ, а не из воздуха
      syncWithFS();

      const isLib = (app.categories || []).includes('library');
      if (!isLib) {
        const lnkPath = `/home/user/desktop/${app.id}.lnk`;
        let lnkExists = false;
        try {
          const check = kernel.fs.read(lnkPath);
          if (check && (typeof check === 'string' || check.data)) lnkExists = true;
        } catch(e) {}

        // ИСПРАВЛЕНИЕ ЯРЛЫКОВ: Создаем ярлык ТОЛЬКО если его физически нет.
        // Если он есть - мы его не трогаем, чтобы не сбить кастомное имя.
        if (!lnkExists) {
          kernel.fs.write(lnkPath, JSON.stringify({
            appId: app.id,
            icon: app.icon || '📦',
            name: app.name,
          }));
          kernel.emit('desktop:refresh');
        }
      }

      setStatus(`✅ ${app.name} установлен!`);
      renderGrid();

    } catch (err) {
      console.error('[NutStore]', err);
      await kernel.dialog.error('Ошибка установки', `${app.name}: ${err.message}`);
      setStatus('Ошибка');
    } finally {
      busy = false;
    }
  }

  async function removeApp(appId) {
    const inst = installedMap[appId];
    if (!inst && !kernel.getApp(appId)) return;

    const app = catalog.apps.find(a => a.id === appId);
    const name = app ? app.name : appId;

    const ok = await kernel.dialog.confirm('Удаление', `Удалить "${name}"?`);
    if (!ok) return;

    const procs = kernel.getProcesses().filter(p => p.appId === appId);
    for (const p of procs) kernel.kill(p.pid);

    if (inst && inst.path && inst.path !== '?') {
      kernel.fs.rm(inst.path);
    }

    kernel.fs.rm(`/home/user/desktop/${appId}.lnk`);
    kernel.emit('desktop:refresh');
    kernel.unregisterApp(appId);

    // Синхронизация с диском после удаления
    syncWithFS();

    setStatus(`🗑 ${name} удалён`);
    renderGrid();
  }

  function launchApp(appId) { kernel.launch(appId); }

  async function selfUpdate() {
    if (busy) return;
    const self = catalog.apps.find(a => a.id === 'nutstore');
    const inst = getInstalledInfo('nutstore');
    if (inst && !isNewer(self.version, inst.version)) {
      await kernel.dialog.alert('NutStore', `У вас актуальная версия (v${inst.version}).`);
      return;
    }

    const ok = await kernel.dialog.confirm('Обновление NutStore',
      `Обновить NutStore с v${inst ? inst.version : '?'} до v${self.version}?\nОкно будет перезапущено.`);
    if (!ok) return;

    busy = true;
    setStatus('Скачивание обновления...');
    try {
      const res = await fetch(REPO_BASE + self.downloadUrl);
      const code = await res.text();
      kernel.fs.write(`/apps/nutstore.orex`, code);
      
      syncWithFS();
      await kernel.launchOrex(`/apps/nutstore.orex`, { _registerOnly: true });
      await kernel.dialog.alert('NutStore', '✅ Обновлено! Перезапустите NutStore.');
      const wid = kernel.getProcess(pid)?.windowId;
      if (wid) kernel.wm.closeWindow(wid);
    } catch (err) {
      await kernel.dialog.error('Ошибка обновления', err.message);
    } finally {
      busy = false;
    }
  }

  async function loadCatalog() {
    setStatus('Загрузка каталога...');
    content.innerHTML = '<div class="ns-loading">🥜 Загрузка каталога...</div>';

    try {
      const res = await fetch(INDEX_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      catalog = await res.json();
      kernel.state.save('nutstore:catalog-cache', catalog);
      
      statusRight.textContent = `Обновлено: ${new Date(catalog.generated || Date.now()).toLocaleString()}`;
      setStatus(`Загружено: ${catalog.apps.length} приложений`);

      // КАК ТОЛЬКО СКАЧАЛИ КАТАЛОГ — ПРОВЕРЯЕМ ДИСК
      syncWithFS();
      renderSidebar();
      renderGrid();

    } catch (err) {
      const cached = kernel.state.load('nutstore:catalog-cache', null);
      if (cached) {
        catalog = cached;
        statusRight.textContent = '(из кэша)';
        syncWithFS();
        renderSidebar();
        renderGrid();
      } else {
        content.innerHTML = `<div class="ns-empty">❌ Ошибка сети.<br><br>Нажмите 🔄 Обновить.</div>`;
      }
    }
  }

  /* ─── Утилиты ─── */
  function esc(s) {
    const d = document.createElement('div');
    d.textContent = String(s);
    return d.innerHTML;
  }
  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' Б';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' КБ';
    return (bytes / 1048576).toFixed(1) + ' МБ';
  }
  function setStatus(text) {
    statusLeft.textContent = text;
    statusText.textContent = text;
    clearTimeout(setStatus._t);
    setStatus._t = setTimeout(() => { statusText.textContent = ''; }, 3000);
  }

  let searchTimer;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => { searchQuery = searchInput.value.trim(); renderGrid(); }, 250);
  });

  btnRefresh.addEventListener('click', () => loadCatalog());
  btnSelf.addEventListener('click', () => selfUpdate());

  kernel.wm.setWindowContextMenu(pid, [
    { label: '🔄 Обновить каталог', action: () => loadCatalog() },
    { label: '🥜 Обновить NutStore', action: () => selfUpdate() },
  ]);

  kernel.onSignal(pid, () => {
    clearTimeout(searchTimer);
    clearTimeout(setStatus._t);
    kernel.wm.clearWindowContextMenu(pid);
  });

  /* ─── Старт ─── */
  loadCatalog();
}
@end
