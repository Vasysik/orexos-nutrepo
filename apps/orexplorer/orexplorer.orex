#!/usr/bin/orex

@manifest
id:      orexplorer
name:    Orexplorer
icon:    🌐
version: 1.0.0
type:    gui
size:    850x600
single:  false
desc:    Ультимативный веб-браузер OrexOS
author:  Orexia Systems
@end

@style
.browser-root {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #c0c0c0;
    font-family: 'Trebuchet MS', sans-serif;
    overflow: hidden;
}
.browser-toolbar {
    display: flex;
    gap: 4px;
    padding: 6px;
    border-bottom: 2px solid #808080;
    align-items: center;
}
.browser-btn {
    padding: 4px 10px;
    background: #dfdfdf;
    border: 2px solid;
    border-color: #fff #808080 #808080 #fff;
    cursor: pointer;
    font-size: 14px;
}
.browser-btn:active {
    border-color: #808080 #fff #fff #808080;
}
.browser-btn:disabled {
    color: #888;
    border-color: #dfdfdf #aaa #aaa #dfdfdf;
    cursor: not-allowed;
}
.browser-url {
    flex: 1;
    padding: 4px 6px;
    font-size: 13px;
    border: 2px inset #808080;
    outline: none;
}
.browser-iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: #fff;
    min-height: 0;
}
.browser-status {
    padding: 2px 6px;
    font-size: 11px;
    color: #333;
    border-top: 2px solid #808080;
    background: #c0c0c0;
}
@end

@template
<div class="browser-root">
    <div class="browser-toolbar">
        <button class="browser-btn" id="btn-back" title="Назад" disabled>⬅️</button>
        <button class="browser-btn" id="btn-forward" title="Вперед" disabled>➡️</button>
        <button class="browser-btn" id="btn-reload" title="Обновить">🔄</button>
        <button class="browser-btn" id="btn-home" title="Домой">🏠</button>
        
        <input type="text" class="browser-url" id="url-bar" value="https://neosearch.neocities.org/" placeholder="Введите URL и нажмите Enter..." spellcheck="false" />
        
        <button class="browser-btn" id="btn-go">Перейти</button>
    </div>
    
    <iframe class="browser-iframe" id="web-frame" src="https://neosearch.neocities.org/" sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
    
    <div class="browser-status" id="status-bar">Готово</div>
</div>
@end

@script
function init($el, kernel, pid, args) {
    var frame = $el.querySelector('#web-frame');
    var urlBar = $el.querySelector('#url-bar');
    var btnGo = $el.querySelector('#btn-go');
    var btnReload = $el.querySelector('#btn-reload');
    var btnBack = $el.querySelector('#btn-back');
    var btnForward = $el.querySelector('#btn-forward');
    var btnHome = $el.querySelector('#btn-home');
    var statusBar = $el.querySelector('#status-bar');

    var homeUrl = 'https://neosearch.neocities.org/';
    var historyList =[homeUrl];
    var currentIndex = 0;

    function updateNavButtons() {
        btnBack.disabled = currentIndex <= 0;
        btnForward.disabled = currentIndex >= historyList.length - 1;
    }

    function navigate(url, isHistoryAction = false) {
        if (!url) return;
        
        if (!url.startsWith('http://') && !url.startsWith('https://')) {
            url = 'https://' + url;
        }

        statusBar.textContent = 'Загрузка: ' + url + ' ...';
        urlBar.value = url;
        frame.src = url;

        if (!isHistoryAction) {
            historyList = historyList.slice(0, currentIndex + 1);
            historyList.push(url);
            currentIndex++;
        }
        
        updateNavButtons();
    }

    btnGo.addEventListener('click', function() {
        navigate(urlBar.value);
    });

    urlBar.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            navigate(urlBar.value);
        }
    });

    btnReload.addEventListener('click', function() {
        statusBar.textContent = 'Обновление страницы...';
        frame.src = frame.src;
    });

    btnHome.addEventListener('click', function() {
        navigate(homeUrl);
    });

    btnBack.addEventListener('click', function() {
        if (currentIndex > 0) {
            currentIndex--;
            navigate(historyList[currentIndex], true);
        }
    });

    btnForward.addEventListener('click', function() {
        if (currentIndex < historyList.length - 1) {
            currentIndex++;
            navigate(historyList[currentIndex], true);
        }
    });

    frame.addEventListener('load', function() {
        statusBar.textContent = 'Готово';
    });
}
@end
